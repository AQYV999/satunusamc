import { RANKS } from '../data/ranks';
import { WhatsAppButton } from '../components/WhatsAppButton';

export function Store() {
  const leftColor: Record<string, string> = {
    ROOKIE: '#94a3b8',
    KNIGHT: '#3b82f6',
    LORD: '#a855f7',
    ETERNAL: '#10b981',
  };

  return (
    <div className="max-w-7xl mx-auto px-4 py-20">
      <div className="text-center max-w-2xl mx-auto mb-16 space-y-4">
        <h1 className="text-4xl font-extrabold text-white">Server Store</h1>
        <p className="text-slate-400">Dukung perkembangan server dengan membeli rank eksklusif dan dapatkan keuntungan istimewa.</p>
      </div>
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {RANKS.map((rank) => (
          <div
            key={rank.id}
            className="card flex flex-col justify-between"
            style={{ borderLeftWidth: '4px', borderLeftColor: leftColor[rank.name] || '#10b981' }}
          >
            <div className="space-y-4">
              <div>
                <h3 className="text-2xl font-bold text-white mb-1">{rank.name}</h3>
                <p className="text-sm text-slate-400">{rank.description}</p>
              </div>
              <div className="text-2xl font-extrabold text-emerald-400">{rank.price}</div>
              <div className="space-y-2 pt-2 border-t border-[#1f1f23]">
                <div className="text-xs font-semibold text-slate-500 uppercase tracking-wider">Keuntungan:</div>
                <ul className="space-y-2 text-sm text-slate-300">
                  {rank.benefits.map((b, i) => (
                    <li key={i} className="flex items-start gap-2">
                      <span className="text-emerald-400 mt-0.5">✓</span>
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
            <div className="pt-6 mt-6 border-t border-[#1f1f23]">
              <WhatsAppButton rankName={rank.name} label="Beli via WhatsApp" />
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}